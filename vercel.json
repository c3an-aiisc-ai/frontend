{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd c3an-building && npm install && npm run build",
  "outputDirectory": "c3an-building/dist",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{c3an-building/dist/**,c3an-building/src/**,c3an-building/node_modules/**,c3an-building/coverage/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
