# =============================================================================
# SmartPilot LLM Configuration
# =============================================================================
# Controls which LLM backend is used for:
#   - Stage 1: InfoGuide domain Q&A
#   - Stage 2: Final synthesis of all pilot outputs
#
# Supported values:
#   "openai"           → OpenAI API (GPT-4o, GPT-4o-mini, etc.)
#   "remote"           → Any OpenAI-compatible endpoint (Azure, Groq, etc.)
#   "openai-compatible"→ Alias for "remote"
#   "simple"           → No-op rule-based fallback (no API required)

SMARTPILOT_LLM_PROVIDER=openai

# API key for the selected provider.
# For OpenAI: obtain from https://platform.openai.com/api-keys
# For Google AI Studio (Gemma): obtain from https://aistudio.google.com/apikey
SMARTPILOT_LLM_API_KEY=your-api-key-here

# Model name to use.
# OpenAI examples  : gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Gemma examples   : gemma-4-31b-it, gemma-3-27b-it
# Groq examples    : llama3-70b-8192, mixtral-8x7b-32768
SMARTPILOT_LLM_MODEL=gpt-4o-mini

# Request timeout in seconds. Increase for larger/slower models.
SMARTPILOT_LLM_TIMEOUT_SECONDS=30

# =============================================================================
# Optional — override to use a custom OpenAI-compatible endpoint
# (only needed if SMARTPILOT_LLM_PROVIDER is "remote" or "openai-compatible")
# =============================================================================
# SMARTPILOT_LLM_API_URL=https://api.openai.com/v1/chat/completions

# --- Google AI Studio (Gemma via OpenAI-compat endpoint) ---
# SMARTPILOT_LLM_PROVIDER=remote
# SMARTPILOT_LLM_API_KEY=your-google-ai-api-key
# SMARTPILOT_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# SMARTPILOT_LLM_MODEL=gemma-4-31b-it

# --- Groq (OpenAI-compatible) ---
# SMARTPILOT_LLM_PROVIDER=remote
# SMARTPILOT_LLM_API_KEY=your-groq-api-key
# SMARTPILOT_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# SMARTPILOT_LLM_MODEL=llama3-70b-8192

# =============================================================================
# Flask
# =============================================================================
FLASK_SECRET_KEY=change-me-in-production
